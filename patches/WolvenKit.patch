+    public static Settings FitSettings(Settings compressionSettings, int dataLength)
+    {
+        // Write always adds a final chunk, even an empty one
+        var chunkCount = dataLength / compressionSettings.ChunkSize + 1;
+
+        var tableEntriesCount = compressionSettings.TableEntriesCount;
+        while (chunkCount > tableEntriesCount)
+        {
+            tableEntriesCount *= 2;
+        }
+
+        if (tableEntriesCount == compressionSettings.TableEntriesCount)
+        {
+            return compressionSettings;
+        }
+
+        return new Settings { TableEntriesCount = tableEntriesCount, ChunkSize = compressionSettings.ChunkSize };
+    }
